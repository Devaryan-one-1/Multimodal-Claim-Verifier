# Upload only the source needed by the container, even from a working directory
# containing private configuration and customer data.
**
!vercel.json
!Dockerfile
!.dockerignore
!requirements-production.txt
!requirements-local.txt
!app
!app/customer_main.py
!app/pilot_admin.py
!app/pilot_task.py
!app/pilot_worker.py
!app/agents
!app/agents/*.py
!app/extraction
!app/extraction/*.py
!app/pilot
!app/pilot/*.py
!app/pipelines
!app/pipelines/*.py
!app/reasoning
!app/reasoning/*.py
!app/retrieval
!app/retrieval/*.py
!app/services
!app/services/*.py
!app/verification
!app/verification/*.py
!app/ui
app/main.py
app/*preview.py
app/pages/**
app/ui/**
!app/ui/calculation.py
!app/ui/claim_interpretation.py
!scripts
!scripts/backup_restore.py
!scripts/dependency_audit.py
!scripts/migrate_supabase.py
!scripts/test_supabase_storage.py
!scripts/beta_status.py
!deploy
!deploy/*.py
!supabase
!supabase/storage_schema.sql
