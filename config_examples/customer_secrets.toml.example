# Merge into .streamlit/secrets.toml on the customer server. Never commit real values.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_SECRET"
client_id = "REPLACE_WITH_OIDC_CLIENT_ID"
client_secret = "REPLACE_WITH_OIDC_CLIENT_SECRET"
server_metadata_url = "https://YOUR_IDENTITY_PROVIDER/.well-known/openid-configuration"

[pilot]
# Must match the provider's validated iss claim exactly.
issuer = "https://YOUR_IDENTITY_PROVIDER/"
