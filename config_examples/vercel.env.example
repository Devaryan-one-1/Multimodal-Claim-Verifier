# Reference names only: enter actual values privately in Vercel project settings.
# Use Production scope; do not expose production data/keys to preview deployments.
PORT=8501
CUSTOMER_STORAGE=supabase
BETA_PRODUCTION=1
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
CUSTOMER_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_SITE_URL=https://YOUR_APP.vercel.app
SUPABASE_ENABLE_SIGNUP=false
CUSTOMER_KEY_ENCRYPTION_KEY=REPLACE_WITH_THE_EXISTING_PRESERVED_MASTER_KEY
GOOGLE_API_KEY=REPLACE_WITH_OPERATOR_EMBEDDING_KEY
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L6-v2
RERANK_MODEL_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
CUSTOMER_CACHE_ROOT=/tmp/claim-verifier-cache
CLAIM_VERIFIER_LOG_DIR=/tmp/claim-verifier-logs
CUSTOMER_MAX_UPLOAD_MB=4
CUSTOMER_MAX_PAGES=500
CUSTOMER_MAX_DOCUMENTS=30
CUSTOMER_JOBS_PER_DAY=100
CUSTOMER_JOB_TIMEOUT_SECONDS=1800
CUSTOMER_MAX_OUTPUT_TOKENS=8192
CUSTOMER_VISION_MAX_OUTPUT_TOKENS=32768
# Supply a real Discord invite/HTTPS support link or support email before startup.
BETA_FEEDBACK_URL=
BETA_SUPPORT_EMAIL=
# Customers enter their own OpenRouter keys in the app. No operator key here.
