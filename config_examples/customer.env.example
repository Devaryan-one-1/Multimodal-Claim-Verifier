# Use an absolute path on a persistent LOCAL disk shared by UI and worker.
# CUSTOMER_DATA_ROOT=C:/claim-verifier/customer_data
CUSTOMER_MAX_UPLOAD_MB=10
CUSTOMER_MAX_PAGES=500
CUSTOMER_MAX_DOCUMENTS=30
CUSTOMER_JOBS_PER_DAY=100
CUSTOMER_JOB_TIMEOUT_SECONDS=3600
# Optional: explicitly curate a PUBLIC source PDF for onboarding.
# CUSTOMER_EXAMPLE_PDF=C:/public_examples/company_annual_report.pdf
# Existing provider and embedding settings remain in your server environment/.env.
# The worker reads the environment/.env, not the Streamlit secrets provider-key section.
