# Add these settings to your EXISTING .env. Do not replace your .env.
# Keep GOOGLE_API_KEY and every GEMINI_EMBEDDING_* setting exactly as they are.

OPENROUTER_API_KEY=your_openrouter_api_key
LLM_PROVIDER=openrouter

# Optional: copy exact IDs from OpenRouter's catalog, or select them in the sidebar.
# OpenRouter IDs include a provider prefix: google/..., openai/..., anthropic/...
OPENROUTER_TEXT_MODEL=
OPENROUTER_VISION_MODEL=
# Blank means the same model as OPENROUTER_TEXT_MODEL.
OPENROUTER_DRAFT_MODEL=

# Disabled by default. Evaluations disable fallback even when this is true.
LLM_ALLOW_FALLBACKS=false
LLM_TEXT_FALLBACK_MODELS=
LLM_VISION_FALLBACK_MODELS=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=8192

# Leave false unless every selected endpoint accepts temperature.
OPENROUTER_SEND_TEMPERATURE=false
