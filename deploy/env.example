# Copy to deploy/.env. Keep that file private and out of Git/build context.
BETA_ENV_FILE=.env
BETA_IMAGE=claim-verifier:beta
BETA_PORT=8501
BETA_HOST=localhost
BETA_PRODUCTION=0
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SITE_URL=http://localhost:8501
SUPABASE_ENABLE_SIGNUP=true
GOOGLE_API_KEY=REPLACE_WITH_OPERATOR_EMBEDDING_KEY
CUSTOMER_KEY_ENCRYPTION_KEY=REPLACE_WITH_THE_EXISTING_PRESERVED_MASTER_KEY
CUSTOMER_DATA_ROOT=/var/lib/verifier/customer_data
# Match the original embedding settings when migrating data. Do not rebuild it.
# Customer reasoning/vision keys are saved through their own app accounts.
# Do not add an operator OPENROUTER_API_KEY here.
# Optional existing absolute host directories (prepare permissions for UID 10001).
# Defaults are on-host Docker volumes. Off-host storage must be chosen/configured.
# Keep archive and master-key destinations separate; do not commit real locations.
# BETA_BACKUP_ROOT=/mnt/private-backup-archives
# BETA_BACKUP_KEY_ROOT=/mnt/separate-private-key-backups
