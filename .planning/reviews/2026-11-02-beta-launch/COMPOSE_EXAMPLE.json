    ],
    "env_file": "env.example",
    "environment": {
      "CUSTOMER_DATA_ROOT": "/var/lib/verifier/customer_data",
      "CUSTOMER_JOBS_PER_DAY": "100",
      "CUSTOMER_JOB_TIMEOUT_SECONDS": "1800",
      "CUSTOMER_MAX_DOCUMENTS": "30",
      "CUSTOMER_MAX_PAGES": "500",
      "CUSTOMER_MAX_PAGE_PIXELS": "25000000",
      "CUSTOMER_MAX_RENDER_DIMENSION": "10000",
      "CUSTOMER_MAX_UPLOAD_MB": "10",
      "GEMINI_EMBEDDING_DIMENSIONS": "768",
      "GEMINI_EMBEDDING_MODEL": "gemini-embedding-001"
    },
    "image": "claim-verifier:beta",
    "init": true,
    "logging": {
      "driver": "json-file",
      "options": {
        "max-file": "3",
        "max-size": "10m"
      }
    },
    "pids_limit": 256,
    "read_only": true,
    "restart": "unless-stopped",
    "security_opt": [
      "no-new-privileges:true"
    ],
    "stop_grace_period": "30s",
    "tmpfs": [
      "/tmp:rw,nosuid,size=268435456,mode=1777"
    ],
    "user": "10001:10001"
  }
}