{
  "name": "claim-verifier-beta",
  "networks": {
    "default": {
      "name": "claim-verifier-beta_default",
      "ipam": {}
    }
  },
  "services": {
    "backup": {
      "profiles": [
        "tools"
      ],
      "build": {
        "context": "F:\\Multi Modal Change Detector\\multimodal-claim-verifier",
        "dockerfile": "Dockerfile",
        "target": "release"
      },
      "cap_drop": [
        "ALL"
      ],
      "cpus": 1,
      "command": [
        "--help"
      ],
      "entrypoint": [
        "python",
        "scripts/backup_restore.py"
      ],
      "environment": {
        "BETA_ENV_FILE": ".env",
        "BETA_HOST": "localhost",
        "BETA_IMAGE": "claim-verifier:beta",
        "BETA_PORT": "8501",
        "BETA_PRODUCTION": "0",
        "CUSTOMER_DATA_ROOT": "/var/lib/verifier/customer_data",
        "CUSTOMER_JOBS_PER_DAY": "100",
        "CUSTOMER_JOB_TIMEOUT_SECONDS": "1800",
        "CUSTOMER_KEY_ENCRYPTION_KEY": "REPLACE_WITH_THE_EXISTING_PRESERVED_MASTER_KEY",
        "CUSTOMER_MAX_DOCUMENTS": "30",
        "CUSTOMER_MAX_PAGES": "500",
        "CUSTOMER_MAX_PAGE_PIXELS": "25000000",
        "CUSTOMER_MAX_RENDER_DIMENSION": "10000",
        "CUSTOMER_MAX_UPLOAD_MB": "10",
        "GEMINI_EMBEDDING_DIMENSIONS": "768",
        "GEMINI_EMBEDDING_MODEL": "gemini-embedding-001",
        "GOOGLE_API_KEY": "REPLACE_WITH_OPERATOR_EMBEDDING_KEY",
        "SUPABASE_ENABLE_SIGNUP": "true",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_REPLACE_ME",
        "SUPABASE_SITE_URL": "http://localhost:8501",
        "SUPABASE_URL": "https://YOUR_PROJECT.supabase.co"
      },
      "image": "claim-verifier:beta",
      "init": true,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "536870912",
      "network_mode": "none",
      "pids_limit": 256,
      "read_only": true,
      "restart": "no",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "stop_grace_period": "30s",
      "tmpfs": [
        "/tmp:rw,nosuid,size=268435456,mode=1777"
      ],
      "user": "10001:10001",
      "volumes": [
        {
          "type": "volume",
          "source": "customer-data",
          "target": "/var/lib/verifier",
          "volume": {}
        },
        {
          "type": "volume",
          "source": "backups",
          "target": "/backups",
          "volume": {}
        },
        {
          "type": "volume",
          "source": "backup-secrets",
          "target": "/backup-secrets",
          "volume": {}
        }
      ]
    },
    "https": {
      "profiles": [
        "https"
      ],
      "cap_add": [
        "NET_BIND_SERVICE"
      ],
      "cap_drop": [
        "ALL"
      ],
      "cpus": 0.5,
      "command": null,
      "depends_on": {
        "web": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "entrypoint": null,
      "environment": {
        "BETA_HOST": "localhost"
      },
      "image": "caddy:2-alpine",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "268435456",
      "networks": {
        "default": null
      },
      "pids_limit": 128,
      "ports": [
        {
          "mode": "ingress",
          "target": 80,
          "published": "80",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "target": 443,
          "published": "443",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "target": 443,
          "published": "443",
          "protocol": "udp"
        }
      ],
      "read_only": true,
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "tmpfs": [
        "/tmp:rw,nosuid,size=67108864,mode=1777"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "F:\\Multi Modal Change Detector\\multimodal-claim-verifier\\deploy\\Caddyfile",
          "target": "/etc/caddy/Caddyfile",
          "read_only": true,
          "bind": {}
        },
        {
          "type": "volume",
          "source": "caddy-data",
          "target": "/data",
          "volume": {}
        },
        {
          "type": "volume",
          "source": "caddy-config",
          "target": "/config",
          "volume": {}
        }
      ]
    },
    "web": {
      "build": {
        "context": "F:\\Multi Modal Change Detector\\multimodal-claim-verifier",
        "dockerfile": "Dockerfile",
        "target": "release"
      },
      "cap_drop": [
        "ALL"
      ],
      "cpus": 1,
      "command": [
        "web"
      ],
      "entrypoint": null,
      "environment": {
        "BETA_ENV_FILE": ".env",
        "BETA_HOST": "localhost",
        "BETA_IMAGE": "claim-verifier:beta",
        "BETA_PORT": "8501",
        "BETA_PRODUCTION": "0",
        "CUSTOMER_DATA_ROOT": "/var/lib/verifier/customer_data",
        "CUSTOMER_JOBS_PER_DAY": "100",
        "CUSTOMER_JOB_TIMEOUT_SECONDS": "1800",
        "CUSTOMER_KEY_ENCRYPTION_KEY": "REPLACE_WITH_THE_EXISTING_PRESERVED_MASTER_KEY",
        "CUSTOMER_MAX_DOCUMENTS": "30",
        "CUSTOMER_MAX_PAGES": "500",
        "CUSTOMER_MAX_PAGE_PIXELS": "25000000",
        "CUSTOMER_MAX_RENDER_DIMENSION": "10000",
        "CUSTOMER_MAX_UPLOAD_MB": "10",
        "GEMINI_EMBEDDING_DIMENSIONS": "768",
        "GEMINI_EMBEDDING_MODEL": "gemini-embedding-001",
        "GOOGLE_API_KEY": "REPLACE_WITH_OPERATOR_EMBEDDING_KEY",
        "SUPABASE_ENABLE_SIGNUP": "true",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_REPLACE_ME",
        "SUPABASE_SITE_URL": "http://localhost:8501",
        "SUPABASE_URL": "https://YOUR_PROJECT.supabase.co"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "deploy/healthcheck.py",
          "web"
        ],
        "timeout": "5s",
        "interval": "30s",
        "retries": 3,
        "start_period": "40s"
      },
      "image": "claim-verifier:beta",
      "init": true,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "805306368",
      "networks": {
        "default": null
      },
      "pids_limit": 256,
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 8501,
          "published": "8501",
          "protocol": "tcp"
        }
      ],
      "read_only": true,
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "stop_grace_period": "30s",
      "tmpfs": [
        "/tmp:rw,nosuid,size=268435456,mode=1777"
      ],
      "user": "10001:10001",
      "volumes": [
        {
          "type": "volume",
          "source": "customer-data",
          "target": "/var/lib/verifier",
          "volume": {}
        }
      ]
    },
    "worker": {
      "build": {
        "context": "F:\\Multi Modal Change Detector\\multimodal-claim-verifier",
        "dockerfile": "Dockerfile",
        "target": "release"
      },
      "cap_drop": [
        "ALL"
      ],
      "cpus": 2,
      "command": [
        "worker"
      ],
      "entrypoint": null,
      "environment": {
        "BETA_ENV_FILE": ".env",
        "BETA_HOST": "localhost",
        "BETA_IMAGE": "claim-verifier:beta",
        "BETA_PORT": "8501",
        "BETA_PRODUCTION": "0",
        "CUSTOMER_DATA_ROOT": "/var/lib/verifier/customer_data",
        "CUSTOMER_JOBS_PER_DAY": "100",
        "CUSTOMER_JOB_TIMEOUT_SECONDS": "1800",
        "CUSTOMER_KEY_ENCRYPTION_KEY": "REPLACE_WITH_THE_EXISTING_PRESERVED_MASTER_KEY",
        "CUSTOMER_MAX_DOCUMENTS": "30",
        "CUSTOMER_MAX_PAGES": "500",
        "CUSTOMER_MAX_PAGE_PIXELS": "25000000",
        "CUSTOMER_MAX_RENDER_DIMENSION": "10000",
        "CUSTOMER_MAX_UPLOAD_MB": "10",
        "GEMINI_EMBEDDING_DIMENSIONS": "768",
        "GEMINI_EMBEDDING_MODEL": "gemini-embedding-001",
        "GOOGLE_API_KEY": "REPLACE_WITH_OPERATOR_EMBEDDING_KEY",
        "SUPABASE_ENABLE_SIGNUP": "true",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_REPLACE_ME",
        "SUPABASE_SITE_URL": "http://localhost:8501",
        "SUPABASE_URL": "https://YOUR_PROJECT.supabase.co"
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "deploy/healthcheck.py",
          "worker"
        ],
        "timeout": "5s",
        "interval": "15s",
        "retries": 3,
        "start_period": "40s"
      },
      "image": "claim-verifier:beta",
      "init": true,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "mem_limit": "2147483648",
      "networks": {
        "default": null
      },
      "pids_limit": 256,
      "read_only": true,
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "stop_grace_period": "30s",
      "tmpfs": [
        "/tmp:rw,nosuid,size=268435456,mode=1777"
      ],
      "user": "10001:10001",
      "volumes": [
        {
          "type": "volume",
          "source": "customer-data",
          "target": "/var/lib/verifier",
          "volume": {}
        }
      ]
    }
  },
  "volumes": {
    "backup-secrets": {
      "name": "claim-verifier-beta_backup-secrets"
    },
    "backups": {
      "name": "claim-verifier-beta_backups"
    },
    "caddy-config": {
      "name": "claim-verifier-beta_caddy-config"
    },
    "caddy-data": {
      "name": "claim-verifier-beta_caddy-data"
    },
    "customer-data": {
      "name": "claim-verifier-beta_customer-data"
    }
  },
  "x-runtime": {
    "build": {
      "context": "..",
      "dockerfile": "Dockerfile",
      "target": "release"
    },
    "cap_drop": [
